# Copy to .env on the VPS (mode 0600); Compose reads it automatically.
# Replace every placeholder. Never commit the populated file.
OAUTH2_PROXY_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
OAUTH2_PROXY_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_WITH_BASE64_COOKIE_SECRET
OAUTH2_PROXY_ALLOWED_EMAILS_FILE=./runtime/secrets/oauth2-allowed-emails
# On vps-contabo, set both bind addresses to its own Tailscale IPv4 address.
# Loopback defaults keep local development private.
INVOICE_UI_BIND_ADDRESS=127.0.0.1
OAUTH2_PROXY_BIND_ADDRESS=127.0.0.1
# On vps-contabo, replace with the Tailscale IPv4 address of my-vps plus /32.
OAUTH2_PROXY_TRUSTED_PROXY_IPS=127.0.0.1/32
